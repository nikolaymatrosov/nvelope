# CI gate before pushing: the pre-commit hook only runs the fast linters
# + frontend typecheck/i18n, so the slow suite (backend build/test/arch,
# frontend drift checks, test, build, Storybook) runs here. It mirrors
# .github/workflows/ci.yml, but only the half the pushed commits touch:
# docs-only pushes skip CI entirely. Set HUSKY=0 to skip in an emergency.

# Files changed by the commits being pushed. git feeds one line per ref:
# <local ref> <local sha> <remote ref> <remote sha>.
changed=""
while read -r _ local_sha _ remote_sha; do
	echo "$local_sha" | grep -qE '^0+$' && continue # branch deletion
	if echo "$remote_sha" | grep -qE '^0+$'; then
		base="--remotes" # new branch: whatever isn't on the remote yet
	else
		base="$remote_sha"
	fi
	# An unknown base (e.g. the remote moved) can't be diffed — run everything.
	files=$(git log --format= --name-only "$local_sha" --not $base) || files="ALL"
	changed="$changed
$files"
done
changed=$(echo "$changed" | grep -v '\.md$')

# api/ (the OpenAPI spec) and the build/CI config feed both halves.
both='^ALL$|^api/|^Makefile$|^\.github/workflows/'
targets=""
if echo "$changed" | grep -qE "$both|\.go$|^go\.(mod|sum)$|^(cmd|internal)/"; then
	targets="ci-backend"
fi
# internal/auth/adapters/emails is generated by the frontend's emails:build.
if echo "$changed" | grep -qE "$both|^frontend/|^internal/auth/adapters/emails/"; then
	targets="$targets ci-frontend"
fi

if [ -z "$targets" ]; then
	echo "[pre-push] no code changes — skipping CI"
	exit 0
fi

# testcontainers only probes /var/run/docker.sock; Docker Desktop/OrbStack
# setups without it are reachable through the active docker context.
if [ -z "$DOCKER_HOST" ] && [ ! -S /var/run/docker.sock ]; then
	DOCKER_HOST=$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null) && export DOCKER_HOST
fi

# In a linked worktree git exports GIT_DIR to hooks, which pins the work tree
# to the cwd: `cd frontend && git diff ../internal/...` then fails as "outside
# repository". The hook runs from the work tree root, so rediscovery is safe.
unset GIT_DIR

targets=${targets# }
echo "[pre-push] running make $targets..."
make $targets || exit 1
